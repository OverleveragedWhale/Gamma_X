//@version=6
indicator("VARIS Zones", overlay=true, max_lines_count=100, max_labels_count=50)

// ===== Visibility Inputs =====
showVWAP    = input.bool(true, "Show VWAP", group="VWAP")

showUpper1  = input.bool(true, "Show Upper Band 1", group="VWAP")
showLower1  = input.bool(true, "Show Lower Band 1", group="VWAP")
showUpper2  = input.bool(true, "Show Upper Band 2", group="VWAP")
showLower2  = input.bool(true, "Show Lower Band 2", group="VWAP")

// ===== Distance Inputs =====
band1Points = input.float(10.0, "1/2 Risk Interval (Points)", step=0.25, minval=0.001, group="VWAP")
band2Points = input.float(25.0, "1 Full Risk Interval (Points)", step=0.25, minval=0.0, group="VWAP")

// ===== VWAP Style =====
vwapColor   = input.color(color.rgb(255, 0, 0, 10), "VWAP Line Color", group="VWAP Style")
vwapWidth   = input.int(1, "VWAP Line Width", minval=1, maxval=5, group="VWAP Style")

// ===== Band 1 Style =====
upper1Color = input.color(color.rgb(0, 0, 0, 90), "Upper Band 1 Color", group="VWAP Style")
upper1Width = input.int(1, "Upper Band 1 Width", minval=1, maxval=5, group="VWAP Style")

lower1Color = input.color(color.rgb(0, 0, 0, 90), "Lower Band 1 Color", group="VWAP Style")
lower1Width = input.int(1, "Lower Band 1 Width", minval=1, maxval=5, group="VWAP Style")

// ===== Band 2 Style =====
upper2Color = input.color(color.rgb(0, 0, 0, 100), "Upper Band 2 Color", group="VWAP Style")
upper2Width = input.int(1, "Upper Band 2 Width", minval=1, maxval=5, group="VWAP Style")

lower2Color = input.color(color.rgb(0, 0, 0, 100), "Lower Band 2 Color", group="VWAP Style")
lower2Width = input.int(1, "Lower Band 2 Width", minval=1, maxval=5, group="VWAP Style")

// ===== Fill Inputs =====
showFill1       = input.bool(true, "Show Fill Band 1", group="VWAP Style")
fill1Color      = input.color(color.rgb(255, 255, 255), "Band 1 Fill Color", group="VWAP Style")
fill1Trans      = input.int(75, "Band 1 Fill Transparency", minval=0, maxval=100, group="VWAP Style")

showFill2       = input.bool(true, "Show Fill Band 2", group="VWAP Style")
fill2Color      = input.color(color.rgb(0, 0, 0), "Band 2 Fill Color", group="VWAP Style")
fill2Trans      = input.int(90, "Band 2 Fill Transparency", minval=0, maxval=100, group="VWAP Style")

// ============================================================================
// Liquidation bands, pasted from the Gamma Terminal
// ----------------------------------------------------------------------------
// Each product's panel prints a "TradingView paste" chip holding three numbers:
//
//     anchor,99%,99.9%        e.g.  7712.50,62.52,83.06
//
// anchor is the front contract's previous settle; the other two are distances
// in points either side of it. Paste the chip for the product into the matching
// field below. The chart picks its own field from syminfo.root, so one copy of
// this indicator serves all four - set Product manually if the root does not
// match (continuous symbols, CFDs, or a broker with its own naming).
//
// These are anchored on a settled close, so they are a fixed frame for the
// session and do NOT move with price. Repaste when the terminal's anchor date
// changes - the chip updates when the margin config or the front contract does.
// ============================================================================
showLiq   = input.bool(true, "Show Liquidation Bands", group="Liquidation")
liqProd   = input.string("Auto (by symbol)", "Product",
     options=["Auto (by symbol)", "ES", "NQ", "GC", "CL"], group="Liquidation")

pasteES   = input.string("", "ES   anchor,99%,99.9%", group="Liquidation")
pasteNQ   = input.string("", "NQ   anchor,99%,99.9%", group="Liquidation")
pasteGC   = input.string("", "GC   anchor,99%,99.9%", group="Liquidation")
pasteCL   = input.string("", "CL   anchor,99%,99.9%", group="Liquidation")

showAnchor   = input.bool(true,  "Show Anchor (prev settle)", group="Liquidation Style")
anchorColor  = input.color(color.new(color.gray, 40), "Anchor Color", group="Liquidation Style")
liq99Color   = input.color(color.new(color.orange, 20), "99% Color", group="Liquidation Style")
liq999Color  = input.color(color.new(color.red, 20), "99.9% Color", group="Liquidation Style")
liqWidth     = input.int(1, "Liquidation Line Width", minval=1, maxval=5, group="Liquidation Style")
showLiqFill  = input.bool(true, "Shade 99% → 99.9%", group="Liquidation Style")
liqFillTrans = input.int(88, "Liquidation Fill Transparency", minval=0, maxval=100, group="Liquidation Style")
showLiqLabel = input.bool(true, "Label Liquidation Lines", group="Liquidation Style")

// ===== Session Reset Detection (timezone-safe) =====
// Fixed - forces ET regardless of chart timezone
isNewSession = hour(time, "America/New_York") == 18 and minute(time, "America/New_York") == 0

tp = (high + low + close) / 3

var float cumTPV = 0.0
var float cumVol = 0.0

if isNewSession
    cumTPV := tp * volume
    cumVol := volume
else
    cumTPV += tp * volume
    cumVol += volume

vwapValue = cumVol != 0 ? cumTPV / cumVol : na

// ===== Bands =====
upperBand1 = vwapValue + band1Points
lowerBand1 = vwapValue - band1Points

upperBand2 = vwapValue + band2Points
lowerBand2 = vwapValue - band2Points

// ===== Liquidation parsing =====
// Which paste field applies to this chart. syminfo.root is "ES"/"NQ"/"GC"/"CL"
// on CME futures; anything else falls through to blank unless Product is set.
selProd = liqProd == "Auto (by symbol)" ? syminfo.root : liqProd
liqPaste = selProd == "ES" ? pasteES :
           selProd == "NQ" ? pasteNQ :
           selProd == "GC" ? pasteGC :
           selProd == "CL" ? pasteCL : ""

// Spaces stripped first so "7712.50, 62.52, 83.06" parses as readily as the
// bare chip. str.tonumber returns na on anything it cannot read, which is what
// keeps a half-pasted string from drawing a line at a wrong price.
liqParts = str.split(str.replace_all(liqPaste, " ", ""), ",")
liqN     = array.size(liqParts)
liqAnchor = liqN > 0 ? str.tonumber(array.get(liqParts, 0)) : na
liq99Pts  = liqN > 1 ? str.tonumber(array.get(liqParts, 1)) : na
liq999Pts = liqN > 2 ? str.tonumber(array.get(liqParts, 2)) : na

liqOK = showLiq and not na(liqAnchor) and liqAnchor > 0
hi99  = liqOK and not na(liq99Pts)  ? liqAnchor + liq99Pts  : na
lo99  = liqOK and not na(liq99Pts)  ? liqAnchor - liq99Pts  : na
hi999 = liqOK and not na(liq999Pts) ? liqAnchor + liq999Pts : na
lo999 = liqOK and not na(liq999Pts) ? liqAnchor - liq999Pts : na

// ===== Plots =====
vwapPlot   = plot(showVWAP   ? vwapValue   : na, title="VWAP",         color=vwapColor,   linewidth=vwapWidth)

upper1Plot = plot(showUpper1 ? upperBand1  : na, title="Upper Band 1", color=upper1Color, linewidth=upper1Width)
lower1Plot = plot(showLower1 ? lowerBand1  : na, title="Lower Band 1", color=lower1Color, linewidth=lower1Width)

upper2Plot = plot(showUpper2 ? upperBand2  : na, title="Upper Band 2", color=upper2Color, linewidth=upper2Width)
lower2Plot = plot(showLower2 ? lowerBand2  : na, title="Lower Band 2", color=lower2Color, linewidth=lower2Width)

anchorPlot = plot(liqOK and showAnchor ? liqAnchor : na, title="Liq Anchor",
     color=anchorColor, linewidth=liqWidth, style=plot.style_linebr)

hi99Plot  = plot(hi99,  title="Liq 99% Upper",   color=liq99Color,  linewidth=liqWidth, style=plot.style_linebr)
lo99Plot  = plot(lo99,  title="Liq 99% Lower",   color=liq99Color,  linewidth=liqWidth, style=plot.style_linebr)
hi999Plot = plot(hi999, title="Liq 99.9% Upper", color=liq999Color, linewidth=liqWidth, style=plot.style_linebr)
lo999Plot = plot(lo999, title="Liq 99.9% Lower", color=liq999Color, linewidth=liqWidth, style=plot.style_linebr)

// ===== Fills =====
fill(vwapPlot, upper1Plot, color=showFill1 and showUpper1 ? color.new(fill1Color, fill1Trans) : na, title="Upper Fill 1")
fill(vwapPlot, lower1Plot, color=showFill1 and showLower1 ? color.new(fill1Color, fill1Trans) : na, title="Lower Fill 1")

fill(vwapPlot, upper2Plot, color=showFill2 and showUpper2 ? color.new(fill2Color, fill2Trans) : na, title="Upper Fill 2")
fill(vwapPlot, lower2Plot, color=showFill2 and showLower2 ? color.new(fill2Color, fill2Trans) : na, title="Lower Fill 2")

// Shade only the 99% -> 99.9% shoulders, not the whole span: the interesting
// region is between the two confidence levels, and flooding the middle would
// bury the VWAP bands this indicator exists to show.
fill(hi99Plot,  hi999Plot, color=showLiqFill ? color.new(liq999Color, liqFillTrans) : na, title="Liq Upper Shoulder")
fill(lo999Plot, lo99Plot,  color=showLiqFill ? color.new(liq999Color, liqFillTrans) : na, title="Liq Lower Shoulder")

// ===== Liquidation labels =====
// Drawn once, on the last bar only, so they sit at the right edge and do not
// accumulate one per bar.
if barstate.islast and liqOK and showLiqLabel
    var label lHi999 = na, var label lHi99 = na, var label lAnc = na
    var label lLo99 = na, var label lLo999 = na
    label.delete(lHi999), label.delete(lHi99), label.delete(lAnc)
    label.delete(lLo99), label.delete(lLo999)
    tip = selProd + " liq, off " + str.tostring(liqAnchor, format.mintick)
    if not na(hi999)
        lHi999 := label.new(bar_index, hi999, "99.9% " + str.tostring(hi999, format.mintick),
             style=label.style_label_left, color=color.new(color.black, 100),
             textcolor=liq999Color, size=size.small, tooltip=tip)
    if not na(hi99)
        lHi99 := label.new(bar_index, hi99, "99% " + str.tostring(hi99, format.mintick),
             style=label.style_label_left, color=color.new(color.black, 100),
             textcolor=liq99Color, size=size.small, tooltip=tip)
    if showAnchor
        lAnc := label.new(bar_index, liqAnchor, "settle " + str.tostring(liqAnchor, format.mintick),
             style=label.style_label_left, color=color.new(color.black, 100),
             textcolor=anchorColor, size=size.small, tooltip=tip)
    if not na(lo99)
        lLo99 := label.new(bar_index, lo99, "99% " + str.tostring(lo99, format.mintick),
             style=label.style_label_left, color=color.new(color.black, 100),
             textcolor=liq99Color, size=size.small, tooltip=tip)
    if not na(lo999)
        lLo999 := label.new(bar_index, lo999, "99.9% " + str.tostring(lo999, format.mintick),
             style=label.style_label_left, color=color.new(color.black, 100),
             textcolor=liq999Color, size=size.small, tooltip=tip)

// A paste that is present but unreadable is worth saying out loud, otherwise
// the bands simply fail to appear and look like a display bug.
if barstate.islast and showLiq and liqPaste != "" and not liqOK
    var label lWarn = na
    label.delete(lWarn)
    lWarn := label.new(bar_index, close,
         "VARIS: could not read " + selProd + " paste\nexpected anchor,99%,99.9%",
         style=label.style_label_left, color=color.new(color.red, 20),
         textcolor=color.white, size=size.small)
