<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>Gamma_X</Author>
    <Description>Holds the PC awake for the market session so the snapshot task's repetition actually fires. WakeToRun only wakes the machine for a trigger's start boundary, never for a repetition inside its duration, so a sleeping PC loses every repeat. Pairs with GammaX-AllowSleep, which restores the timeout at 17:15.</Description>
    <URI>\Gamma_X Stay Awake</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- 09:00, ahead of the 09:15 session trigger, so sleep is already off
         before the first repetition window opens. -->
    <CalendarTrigger>
      <StartBoundary>2026-01-01T09:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday /><Tuesday /><Wednesday /><Thursday /><Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <!-- InteractiveToken, not Password: powercfg /change edits the calling
           user's own active power scheme and needs neither elevation nor
           network, so there is no reason to store a password for it. -->
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <!-- If the PC was off at 09:00, apply it on the next wake rather than
         skip the whole session. -->
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <!-- Wakes the machine at 09:00 if it is asleep, which is the point. -->
    <WakeToRun>true</WakeToRun>
    <ExecutionTimeLimit>PT1M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\GammaX\Gamma_X\tools\market_sleep.bat</Command>
      <Arguments>0</Arguments>
    </Exec>
  </Actions>
</Task>
