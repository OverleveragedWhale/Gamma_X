<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>Gamma_X</Author>
    <Description>Generates the GEX dashboard and publishes it to the snapshot branch that GitHub Pages serves. Polls every minute from 09:25 to 16:25 on weekdays, and every 4 hours outside that. The run only pushes when the figures actually change (--skip-unchanged), so a minute-by-minute poll still publishes at roughly the rate the ~15 min delayed Cboe feed updates. All times are the machine's local clock, so set it to Eastern.</Description>
    <URI>\Gamma_X Snapshot</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- Session: every minute, 09:25 through 16:25, weekdays. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT1M</Interval>
        <Duration>PT7H</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T09:25:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
    <!-- Off-hours: 20:16, 00:16, 04:16, 08:16 every day. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT4H</Interval>
        <Duration>PT12H</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T20:16:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <!-- Replace with COMPUTERNAME\YourUser, or set it in the General tab
           after importing. LogonType must be Password, not S4U: an S4U task
           runs without network access, which would break both the data fetch
           and the git push. -->
      <UserId>REPLACE\WITH_YOUR_USER</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- A tablet is on battery often enough that the defaults here would
         silently skip most runs. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>true</WakeToRun>
    <!-- A run is seconds of work; cap it well under the 1 minute cadence so a
         hung fetch cannot block the following runs for long. IgnoreNew above
         means a slow run is skipped rather than queued behind itself. -->
    <ExecutionTimeLimit>PT3M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\GammaX\Gamma_X\tools\publish_snapshot.bat</Command>
    </Exec>
  </Actions>
</Task>
