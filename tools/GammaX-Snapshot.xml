<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>Gamma_X</Author>
    <Description>Generates the GEX dashboard and publishes it to the snapshot branch that GitHub Pages serves. Weekdays: every 15 minutes from 09:15 to 14:45, then every 5 minutes from 15:00 to 17:00. Every 4 hours otherwise. Runs only push when the figures actually change (--skip-unchanged). All times are the machine's local clock, so set it to Eastern.</Description>
    <URI>\Gamma_X Snapshot</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- Session: every 15 minutes, 09:15 through 14:45, weekdays. 24 runs.
         Stops at 14:45 so the 5-minute trigger owns 15:00 outright rather
         than both firing on the same minute. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT15M</Interval>
        <Duration>PT5H30M</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T09:15:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
    <!-- Close window: every 5 minutes, 15:00 through 17:00, weekdays. 25 runs. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT5M</Interval>
        <Duration>PT2H</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T15:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
    <!-- Off-hours: 20:00, 00:00, 04:00, 08:00 every day. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT4H</Interval>
        <Duration>PT12H</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T20:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <!-- Replace with COMPUTERNAME\YourUser, or set it in the General tab
           after importing. LogonType must be Password, not S4U: an S4U task
           runs without network access, which would break both the data fetch
           and the git push. -->
      <UserId>REPLACE\WITH_YOUR_USER</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- A tablet is on battery often enough that the defaults here would
         silently skip most runs. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>true</WakeToRun>
    <!-- A run is seconds of work; cap it well under the 1 minute cadence so a
         hung fetch cannot block the following runs for long. IgnoreNew above
         means a slow run is skipped rather than queued behind itself. -->
    <ExecutionTimeLimit>PT3M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\GammaX\Gamma_X\tools\publish_snapshot.bat</Command>
    </Exec>
  </Actions>
</Task>
