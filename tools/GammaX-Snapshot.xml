  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- Windows skips a task by default whenever the machine reports
         battery power. Moot on a desktop, fatal on anything portable. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>true</WakeToRun>
    <!-- Wakes the machine for each trigger's START BOUNDARY only. Repetition
         instances inside a <Duration> do not wake it, which is why the
         publisher holds the machine awake across the session - without that
         this task lands 3 scheduled runs a day instead of 50. Measured on the
         snapshot branch 09-21 to 09-23: the 3 start boundaries fired
         unattended every day, and 0 of the other 47 occurrences ever did. -->
    <!-- A run is seconds of work; cap it well under the 5 minute close-window
         cadence so a hung fetch cannot block the runs behind it for long.
         IgnoreNew above means a slow run is skipped, not queued up. -->
    <ExecutionTimeLimit>PT3M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\GammaX\Gamma_X\tools\publish_snapshot.bat</Command>
    </Exec>
  </Actions>
