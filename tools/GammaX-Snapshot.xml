<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Author>Gamma_X</Author>
    <Description>Generates the GEX dashboard and publishes it to the snapshot branch that GitHub Pages serves. Weekdays: every 15 minutes from 09:15 to 14:45, then every 5 minutes from 15:00 to 16:45, then once at 18:20. Every 4 hours otherwise. Runs only push when the figures actually change (--skip-unchanged). All times are the machine's local clock, so set it to Eastern. WakeToRun below wakes the PC for a trigger's start boundary but never for a repetition inside its duration, so publish_snapshot.bat holds the machine awake for the session on every run - without that the 09:15 run happens and every repeat behind it is lost. That means BOTH sleep timers: the attended idle one, and the unattended one Windows uses after a wake no human initiated, whose 120s default is what actually put the PC back to sleep after each run on 09-21 through 09-23. See market_sleep.bat.</Description>
    <URI>\Gamma_X Snapshot</URI>
  </RegistrationInfo>
  <Triggers>
    <!-- Session: every 15 minutes, 09:15 through 14:45, weekdays. 24 runs.
         Stops at 14:45 so the 5-minute trigger owns 15:00 outright rather
         than both firing on the same minute. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT15M</Interval>
        <Duration>PT5H30M</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T09:15:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
    <!-- Close window: every 5 minutes, 15:00 through 16:45, weekdays. 22 runs. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT5M</Interval>
        <Duration>PT1H45M</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T15:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
    <!-- Settlement follow-up: one run at 18:20, weekdays. No repetition, so
         this is a start boundary and WakeToRun picks it up even though
         Gamma_X Allow Sleep restored the idle timeout at 17:15. -->
    <CalendarTrigger>
      <StartBoundary>2026-01-01T18:20:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByWeek>
        <DaysOfWeek>
          <Monday />
          <Tuesday />
          <Wednesday />
          <Thursday />
          <Friday />
        </DaysOfWeek>
        <WeeksInterval>1</WeeksInterval>
      </ScheduleByWeek>
    </CalendarTrigger>
    <!-- Off-hours: 20:00, 00:00, 04:00, 08:00 every day. -->
    <CalendarTrigger>
      <Repetition>
        <Interval>PT4H</Interval>
        <Duration>PT12H</Duration>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <StartBoundary>2026-01-01T20:00:00</StartBoundary>
      <Enabled>true</Enabled>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <!-- Replace with COMPUTERNAME\YourUser, or set it in the General tab
           after importing. LogonType must be Password, not S4U: an S4U task
           runs without network access, which would break both the data fetch
           and the git push. -->
      <UserId>REPLACE\WITH_YOUR_USER</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <!-- Windows skips a task by default whenever the machine reports
         battery power. Moot on a desktop, fatal on anything portable. -->
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>true</WakeToRun>
    <!-- Wakes the machine for each trigger's START BOUNDARY only. Repetition
         instances inside a <Duration> do not wake it, which is why the
         publisher holds the machine awake across the session - without that
         this task lands 3 scheduled runs a day instead of 50. Measured on the
         snapshot branch 09-21 to 09-23: the 3 start boundaries fired
         unattended every day, and 0 of the other 47 occurrences ever did. -->
    <!-- A run is seconds of work; cap it well under the 5 minute close-window
         cadence so a hung fetch cannot block the runs behind it for long.
         IgnoreNew above means a slow run is skipped, not queued up. -->
    <ExecutionTimeLimit>PT3M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>C:\GammaX\Gamma_X\tools\publish_snapshot.bat</Command>
    </Exec>
  </Actions>
</Task>
