           after importing. LogonType must be Password, not S4U: an S4U task
           runs without network access, which would break both the data fetch
           and the git push. -->
      <UserId>REPLACE\WITH_YOUR_USER</UserId>
      <LogonType>Password</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
