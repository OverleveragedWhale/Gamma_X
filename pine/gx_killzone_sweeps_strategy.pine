// GENERATED by pine/build.py from pine/src/gx_killzones.pine - edit the source.
//@version=6
// Gamma/X Killzone Sweeps - a killzone pivot swept and reclaimed, with the
// Gamma/X map on top. pine/build.py makes the indicator and the strategy from
// this one source, so they cannot drift apart.
//
// Killzones (ET, the TFO "ICT Killzones & Pivots" defaults):
//   ASIA 20:00-00:00  LNDN 02:00-05:00  NYAM 09:30-11:00  NYPM 13:30-16:00
// Each trades a sweep of the PREVIOUS killzone's high or low inside its own
// window (or of every killzone pivot since the prior NYPM), flat by:
//   ASIA 02:00   LNDN 09:30   NYAM 13:30   NYPM 16:00
// Rule (tools/killzone_research.py): a bar inside the killzone trades a tick
// beyond the pivot; it or one of the next two closes back inside; enter on
// that close; stop a tick past the wick (2-5 ES / 8-30 NQ, wider skipped);
// stop to entry from the bar after +1R; target 10 ES / 40 NQ; two trades a
// killzone, one open at a time. A bar touching stop and target is the stop.
// Backtest 2026-08-10 to 10-16: ES 51 trades +$3,850 max DD -$975;
// NQ 49 trades +$2,425 (ASIA -$1,845; without it 32 trades +$4,270). Not advice.
strategy("Gamma/X Killzone Sweeps (strategy)", shorttitle = "GX KZ strat", overlay = true, max_lines_count = 500, max_labels_count = 500,
         process_orders_on_close = true, default_qty_type = strategy.fixed, default_qty_value = 1,
         commission_type = strategy.commission.cash_per_contract, commission_value = 0, slippage = 0)

// ------------------------------------------------------------------ inputs
gKZ = "Killzones"
use0 = input.bool(true, "", inline = "K0", group = gKZ)
ses0 = input.session("2000-0000", "ASIA", inline = "K0", group = gKZ)
flat0 = input.int(200, "flat by (hhmm)", inline = "K0", group = gKZ)
use1 = input.bool(true, "", inline = "K1", group = gKZ)
ses1 = input.session("0200-0500", "LNDN", inline = "K1", group = gKZ)
flat1 = input.int(930, "flat by (hhmm)", inline = "K1", group = gKZ)
use2 = input.bool(true, "", inline = "K2", group = gKZ)
ses2 = input.session("0930-1100", "NYAM", inline = "K2", group = gKZ)
flat2 = input.int(1330, "flat by (hhmm)", inline = "K2", group = gKZ)
use3 = input.bool(true, "", inline = "K3", group = gKZ)
ses3 = input.session("1330-1600", "NYPM", inline = "K3", group = gKZ)
flat3 = input.int(1600, "flat by (hhmm)", inline = "K3", group = gKZ)
levelsMode = input.string("Previous killzone", "Pivots each killzone trades",
             options = ["Previous killzone", "All since prior NYPM"], group = gKZ)

gR = "Rules"
tz = input.string("America/New_York", "Exchange time zone", group = gR)
useBE = input.bool(true, "Breakeven at +1R", group = gR)
maxPerKz = input.int(2, "Max trades a killzone", minval = 1, maxval = 5, group = gR)
nDays = input.int(20, "Backtest the last N trading days (0 = all history)", minval = 0, group = gR)

gG = "Gamma"
gexStr = input.text_area("", "Gamma map string (setups page, this symbol)", group = gG)
gexFilter = input.string("Off", "Gamma filter", options = ["Off", "Only at a gamma level", "Skip at a gamma level"],
            tooltip = "Applies only to killzones the pasted string has a map for; others trade as normal.", group = gG)
showGex = input.bool(true, "Draw the latest map", group = gG)

gD = "Display"
showLv = input.bool(true, "Draw the pivots each killzone trades", group = gD)
showTable = input.bool(true, "Results table", group = gD)
doAlerts = input.bool(true, "Alerts on entry and exit", group = gD)

// ----------------------------------------------------- symbol parameters
isNQ = str.contains(syminfo.root, "NQ")
symKey = isNQ ? "NQ" : "ES"
tgtPts = isNQ ? 40.0 : 10.0
minStop = isNQ ? 8.0 : 2.0
maxStop = isNQ ? 30.0 : 5.0
gexTol = isNQ ? 20.0 : 5.0
tick = syminfo.mintick

// ------------------------------------------------------------------ clock
hhmm = hour(time, tz) * 100 + minute(time, tz)
prevHhmm = nz(hhmm[1], hhmm)
closeHm = hour(time_close, tz) * 100 + minute(time_close, tz)
crossed(int t) => hhmm >= t and prevHhmm < t

KZ_NAME = array.from("ASIA", "LNDN", "NYAM", "NYPM")
KZ_CODE = array.from("A", "L", "N", "P")
// raw membership (pivots are recorded even for a killzone that is not traded)
raw0 = not na(time(timeframe.period, ses0, tz))
raw1 = not na(time(timeframe.period, ses1, tz))
raw2 = not na(time(timeframe.period, ses2, tz))
raw3 = not na(time(timeframe.period, ses3, tz))
pr0 = raw0[1]
pr1 = raw1[1]
pr2 = raw2[1]
pr3 = raw3[1]
rawIn(int i) => i == 0 ? raw0 : i == 1 ? raw1 : i == 2 ? raw2 : raw3
rawPrev(int i) => i == 0 ? pr0 : i == 1 ? pr1 : i == 2 ? pr2 : pr3
useKz(int i) => i == 0 ? use0 : i == 1 ? use1 : i == 2 ? use2 : use3
flatOf(int i) => i == 0 ? flat0 : i == 1 ? flat1 : i == 2 ? flat2 : flat3

// --------------------------------------------- backtest window (N days)
var int cutoff = 0
if barstate.isfirst and nDays > 0
    int t = last_bar_time
    int cnt = 0
    while cnt < nDays
        t -= 86400000
        int dw = dayofweek(t, tz)
        if dw != dayofweek.saturday and dw != dayofweek.sunday
            cnt += 1
    cutoff := t
inWindow = time >= cutoff

// ------------------------------------------------------------- gamma maps
// One entry per killzone: MMDDK,R,flip,cw1/cw2,pw1/pw2 ; K = A L N P
var gKey = array.new_string()
var gPx = array.new_float()
var gTyp = array.new_string()
var string lastKey = ""
var string lastReg = ""
if barstate.isfirst and str.length(gexStr) > 0
    s = str.replace_all(str.replace_all(str.replace_all(gexStr, " ", ""), "\n", ""), "\r", "")
    for e in str.split(s, ";")
        f = str.split(e, ",")
        if array.size(f) >= 5 and str.length(array.get(f, 0)) == 5
            k = array.get(f, 0)
            lastKey := k
            lastReg := array.get(f, 1)
            fl = str.tonumber(array.get(f, 2))
            if not na(fl)
                array.push(gKey, k)
                array.push(gPx, fl)
                array.push(gTyp, "FLIP")
            for x in str.split(array.get(f, 3), "/")
                n = str.tonumber(x)
                if not na(n)
                    array.push(gKey, k)
                    array.push(gPx, n)
                    array.push(gTyp, "CW")
            for x in str.split(array.get(f, 4), "/")
                n = str.tonumber(x)
                if not na(n)
                    array.push(gKey, k)
                    array.push(gPx, n)
                    array.push(gTyp, "PW")

// [has map, nearest type, nearest level, distance] for a key
gexNear(string key, float px) =>
    bool has = false
    string nm = ""
    float lv = na
    float dist = na
    int n = array.size(gKey)
    for i = 0 to (n > 0 ? n - 1 : 0)
        if n > 0 and array.get(gKey, i) == key
            has := true
            d = math.abs(array.get(gPx, i) - px)
            if na(dist) or d < dist
                dist := d
                lv := array.get(gPx, i)
                nm := array.get(gTyp, i)
    [has, nm, lv, dist]

// ------------------------------------------------------- killzone pivots
var pivHi = array.new_float(4, na)      // last completed pivots
var pivLo = array.new_float(4, na)
var curHi = array.new_float(4, na)      // building
var curLo = array.new_float(4, na)
for i = 0 to 3
    bool r = rawIn(i)
    bool r1 = rawPrev(i)
    if r and not r1
        array.set(curHi, i, high)
        array.set(curLo, i, low)
    else if r
        array.set(curHi, i, math.max(array.get(curHi, i), high))
        array.set(curLo, i, math.min(array.get(curLo, i), low))
    if not r and r1
        array.set(pivHi, i, array.get(curHi, i))
        array.set(pivLo, i, array.get(curLo, i))

// ------------------------------------------- the levels the active zone trades
var lvPx = array.new_float()
var lvUp = array.new_bool()
var lvName = array.new_string()
var lvDone = array.new_bool()
var lvSweep = array.new_int()
var lvExt = array.new_float()
var int actKz = na
var string actKey = ""
var int nThisKz = 0

addLevel(float px, bool up, string nm) =>
    if not na(px)
        array.push(lvPx, px)
        array.push(lvUp, up)
        array.push(lvName, nm)
        array.push(lvDone, false)
        array.push(lvSweep, na)
        array.push(lvExt, na)

for i = 0 to 3
    bool r = rawIn(i)
    bool r1 = rawPrev(i)
    if r and not r1 and useKz(i)
        array.clear(lvPx)
        array.clear(lvUp)
        array.clear(lvName)
        array.clear(lvDone)
        array.clear(lvSweep)
        array.clear(lvExt)
        actKz := i
        actKey := str.format_time(time, "MMdd", tz) + array.get(KZ_CODE, i)
        nThisKz := 0
        prev = (i + 3) % 4
        if levelsMode == "Previous killzone"
            addLevel(array.get(pivHi, prev), true, array.get(KZ_NAME, prev) + " H")
            addLevel(array.get(pivLo, prev), false, array.get(KZ_NAME, prev) + " L")
        else
            // every pivot since the prior NYPM: NYPM (index 3), then ASIA.. up to i-1
            addLevel(array.get(pivHi, 3), true, "NYPM H")
            addLevel(array.get(pivLo, 3), false, "NYPM L")
            if i > 0
                for j = 0 to i - 1
                    addLevel(array.get(pivHi, j), true, array.get(KZ_NAME, j) + " H")
                    addLevel(array.get(pivLo, j), false, array.get(KZ_NAME, j) + " L")
        if showLv
            col = i == 0 ? color.blue : i == 1 ? color.red : i == 2 ? color.teal : color.fuchsia
            int nl = array.size(lvPx)
            for k = 0 to (nl > 0 ? nl - 1 : 0)
                if nl > 0
                    p = array.get(lvPx, k)
                    line.new(bar_index, p, bar_index + 24, p, color = color.new(col, 10), width = 1)
                    label.new(bar_index, p, array.get(lvName, k) + " " + str.tostring(p, format.mintick),
                              style = array.get(lvUp, k) ? label.style_label_down : label.style_label_up,
                              color = color.new(col, 80), textcolor = col, size = size.tiny)

inActive = not na(actKz) and rawIn(actKz) and useKz(actKz)

// ---------------------------------------------------------- trade state
var int dir = 0
var float ePx = na
var float sPx = na
var float tPx = na
var float risk = na
var bool armed = false
var int eBar = na
var int tFlat = na
var int tKz = na
var bool tGam = false
var bool tMap = false
var line eLine = na
var line sLine = na
var line tLine = na
var kzN = array.new_int(4, 0)
var kzW = array.new_int(4, 0)
var kzL = array.new_int(4, 0)
var kzB = array.new_int(4, 0)
var kzPts = array.new_float(4, 0.0)
var float sumPts = 0.0
var float peakPts = 0.0
var float ddPts = 0.0
var int gN = 0
var float gPts = 0.0
var int ngN = 0
var float ngPts = 0.0

// 1) manage the open trade (exits first, so a reclaim on the exit bar can trade)
float exitPts = na
string exitHow = ""
if dir != 0 and bar_index > eBar
    if crossed(tFlat)
        exitPts := (close[1] - ePx) * dir
        exitHow := "time"
    else
        a = dir > 0 ? ePx - low : high - ePx
        f = dir > 0 ? high - ePx : ePx - low
        if a >= (armed ? 0.0 : risk)
            exitPts := armed ? 0.0 : -risk
            exitHow := armed ? "breakeven" : "lost"
        else if f >= tgtPts
            exitPts := tgtPts
            exitHow := "won"
        else
            if useBE and not armed and f >= risk
                armed := true
                line.set_y1(sLine, ePx)
                line.set_y2(sLine, ePx)
                strategy.exit("GX x", "GX", stop = ePx, limit = tPx)
            line.set_x2(eLine, bar_index)
            line.set_x2(sLine, bar_index)
            line.set_x2(tLine, bar_index)

if exitHow != ""
    sumPts += exitPts
    peakPts := math.max(peakPts, sumPts)
    ddPts := math.min(ddPts, sumPts - peakPts)
    array.set(kzN, tKz, array.get(kzN, tKz) + 1)
    array.set(kzPts, tKz, array.get(kzPts, tKz) + exitPts)
    if exitHow == "won"
        array.set(kzW, tKz, array.get(kzW, tKz) + 1)
    else if exitHow == "lost"
        array.set(kzL, tKz, array.get(kzL, tKz) + 1)
    else if exitHow == "breakeven"
        array.set(kzB, tKz, array.get(kzB, tKz) + 1)
    if tMap and tGam
        gN += 1
        gPts += exitPts
    else if tMap
        ngN += 1
        ngPts += exitPts
    usdX = exitPts * syminfo.pointvalue
    colX = exitPts > 0 ? color.teal : exitPts < 0 ? color.red : color.gray
    label.new(bar_index, dir > 0 ? high : low, exitHow + " " + (exitPts >= 0 ? "+" : "") + str.tostring(exitPts, "#.##")
              + " / " + (usdX >= 0 ? "+$" : "-$") + str.tostring(math.abs(usdX), "#,###"),
              style = dir > 0 ? label.style_label_down : label.style_label_up,
              color = color.new(colX, 20), textcolor = color.white, size = size.small)
    line.set_x2(eLine, bar_index)
    line.set_x2(sLine, bar_index)
    line.set_x2(tLine, bar_index)
    if doAlerts
        alert(symKey + " " + array.get(KZ_NAME, tKz) + " sweep " + exitHow + ": " + str.tostring(exitPts, "#.##") + " pts",
              alert.freq_once_per_bar_close)
    strategy.close("GX", comment = exitHow)
    dir := 0

// 2) sweep and reclaim of the active killzone's pivots, each once
int sigDir = 0
float sigLvl = na
float sigExt = na
string sigName = ""
if not na(actKz) and array.size(lvPx) > 0
    for k = 0 to array.size(lvPx) - 1
        p = array.get(lvPx, k)
        up = array.get(lvUp, k)
        if inActive and not array.get(lvDone, k) and na(array.get(lvSweep, k)) and (up ? high >= p + tick : low <= p - tick)
            array.set(lvSweep, k, bar_index)
            array.set(lvExt, k, up ? high : low)
            array.set(lvDone, k, true)
        if not na(array.get(lvSweep, k))
            array.set(lvExt, k, up ? math.max(array.get(lvExt, k), high) : math.min(array.get(lvExt, k), low))
            if up ? close < p : close > p
                if sigDir == 0
                    sigDir := up ? -1 : 1
                    sigLvl := p
                    sigExt := array.get(lvExt, k)
                    sigName := array.get(lvName, k)
                array.set(lvSweep, k, na)
            else if bar_index - array.get(lvSweep, k) >= 2
                array.set(lvSweep, k, na)       // held beyond: broken, not swept

// 3) enter: flat, under the killzone's limit, in the window, not its last bar
if sigDir != 0 and dir == 0 and nThisKz < maxPerKz and inWindow and closeHm != flatOf(actKz)
    r = math.max(sigDir < 0 ? sigExt + tick - close : close - (sigExt - tick), minStop)
    [hasMap, gn, gl, gd] = gexNear(actKey, sigLvl)
    bool atG = hasMap and not na(gd) and gd <= gexTol
    bool gOk = not hasMap or gexFilter == "Off" or (gexFilter == "Only at a gamma level" ? atG : not atG)
    if r <= maxStop and gOk
        dir := sigDir
        ePx := close
        risk := r
        sPx := close - sigDir * r
        tPx := close + sigDir * tgtPts
        armed := false
        eBar := bar_index
        tKz := actKz
        tFlat := flatOf(actKz)
        tMap := hasMap
        tGam := atG
        nThisKz += 1
        eLine := line.new(bar_index, ePx, bar_index + 1, ePx, color = color.white, width = 1)
        sLine := line.new(bar_index, sPx, bar_index + 1, sPx, color = color.red, width = 1, style = line.style_dashed)
        tLine := line.new(bar_index, tPx, bar_index + 1, tPx, color = color.teal, width = 1, style = line.style_dashed)
        txt = (sigDir < 0 ? "SHORT " : "LONG ") + array.get(KZ_NAME, actKz) + " · " + sigName + " swept\nstop "
              + str.tostring(r, "#.##") + " · tgt " + str.tostring(tgtPts, "#")
              + (atG ? "\nat " + gn + " " + str.tostring(gl, format.mintick) : hasMap ? "\nno gamma level" : "")
        label.new(bar_index, sigDir < 0 ? high : low, txt, style = sigDir < 0 ? label.style_label_down : label.style_label_up,
                  color = color.new(sigDir < 0 ? color.red : color.teal, 10), textcolor = color.white, size = size.small)
        if doAlerts
            alert(symKey + " " + array.get(KZ_NAME, actKz) + " sweep " + (sigDir < 0 ? "SHORT" : "LONG") + " at "
                  + str.tostring(close, format.mintick) + ", stop " + str.tostring(sPx, format.mintick)
                  + ", target " + str.tostring(tPx, format.mintick), alert.freq_once_per_bar_close)
        strategy.entry("GX", sigDir > 0 ? strategy.long : strategy.short)
        strategy.exit("GX x", "GX", stop = sPx, limit = tPx)
// flat on the last bar before the killzone's flat time, at its close
if strategy.position_size != 0 and dir != 0 and closeHm == tFlat
    strategy.close("GX", comment = "time")

// ---------------------------------------------------------- latest map
var bool drawn = false
if barstate.islast and showGex and not drawn and array.size(gKey) > 0
    drawn := true
    for i = 0 to array.size(gKey) - 1
        if array.get(gKey, i) == lastKey
            p = array.get(gPx, i)
            ty = array.get(gTyp, i)
            col = ty == "CW" ? color.green : ty == "PW" ? color.red : color.yellow
            line.new(bar_index - 1, p, bar_index, p, extend = extend.both, color = color.new(col, 30),
                     style = ty == "FLIP" ? line.style_dashed : line.style_solid)
            label.new(bar_index + 3, p, ty + " " + str.tostring(p, format.mintick) + (ty == "FLIP" and (lastReg == "+" or lastReg == "-") ? " · " + (lastReg == "+" ? "positive" : "negative") + " gamma" : ""),
                      style = label.style_label_left, color = color.new(col, 70), textcolor = col, size = size.tiny)

// ------------------------------------------------------------- table
money(float pts) => (pts >= 0 ? "+$" : "-$") + str.tostring(math.abs(pts * syminfo.pointvalue), "#,###")
var table tb = table.new(position.top_right, 3, 9, bgcolor = color.new(color.black, 30), border_width = 1)
if barstate.islast and showTable
    table.cell(tb, 0, 0, "GX killzone sweeps · " + symKey, text_color = color.orange, text_size = size.small)
    table.cell(tb, 1, 0, "trades · W/L/BE", text_color = color.gray, text_size = size.small)
    table.cell(tb, 2, 0, timeframe.period == "5" ? "1 lot" : "use 5m!", text_color = timeframe.period == "5" ? color.gray : color.red, text_size = size.small)
    for i = 0 to 3
        table.cell(tb, 0, i + 1, array.get(KZ_NAME, i) + (useKz(i) ? "" : " (off)"), text_color = color.gray, text_size = size.small)
        table.cell(tb, 1, i + 1, str.format("{0} · {1}/{2}/{3}", array.get(kzN, i), array.get(kzW, i), array.get(kzL, i), array.get(kzB, i)),
                   text_color = color.white, text_size = size.small)
        table.cell(tb, 2, i + 1, money(array.get(kzPts, i)), text_color = array.get(kzPts, i) >= 0 ? color.teal : color.red, text_size = size.small)
    table.cell(tb, 0, 5, "Total", text_color = color.white, text_size = size.small)
    table.cell(tb, 1, 5, "max DD " + money(ddPts), text_color = color.red, text_size = size.small)
    table.cell(tb, 2, 5, money(sumPts), text_color = sumPts >= 0 ? color.teal : color.red, text_size = size.small)
    table.cell(tb, 0, 6, "At a gamma level", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 6, str.tostring(gN) + " trades", text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 6, money(gPts), text_color = gPts >= 0 ? color.teal : color.red, text_size = size.small)
    table.cell(tb, 0, 7, "Mapped, not at one", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 7, str.tostring(ngN) + " trades", text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 7, money(ngPts), text_color = ngPts >= 0 ? color.teal : color.red, text_size = size.small)
    table.cell(tb, 0, 8, "Window", text_color = color.gray, text_size = size.small)
    table.cell(tb, 1, 8, nDays == 0 ? "all history" : "last " + str.tostring(nDays) + " trading days", text_color = color.white, text_size = size.small)
    table.cell(tb, 2, 8, "map " + (lastKey == "" ? "none" : lastKey), text_color = color.white, text_size = size.small)
